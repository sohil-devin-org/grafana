{
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "name": "@grafana/support-bundles",
  "version": "13.2.0-pre",
  "description": "Grafana support bundles feature module",
  "private": true,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "http://github.com/grafana/grafana.git",
    "directory": "packages/grafana-support-bundles"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@grafana-app/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "./dist",
    "./README.md"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json && rollup -c rollup.config.ts --configPlugin esbuild",
    "bundle": "rollup -c rollup.config.ts --configPlugin esbuild",
    "clean": "rimraf ./dist ./compiled ./package.tgz",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "13.2.0-pre",
    "@grafana/i18n": "13.2.0-pre",
    "@grafana/runtime": "13.2.0-pre",
    "@grafana/ui": "13.2.0-pre",
    "@reduxjs/toolkit": "^2.10.1",
    "lodash": "^4.17.23",
    "react-hook-form": "^7.49.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "@types/lodash": "4.17.20",
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.1",
    "rollup": "^4.60.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
