{
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "name": "@grafana/serviceaccounts",
  "version": "13.2.0-pre",
  "description": "Grafana service accounts feature module",
  "keywords": [
    "grafana",
    "serviceaccounts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "http://github.com/grafana/grafana.git",
    "directory": "packages/grafana-serviceaccounts"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@grafana-app/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist",
    "./README.md"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json && rollup -c rollup.config.ts --configPlugin esbuild",
    "bundle": "rollup -c rollup.config.ts --configPlugin esbuild",
    "clean": "rimraf ./dist ./compiled ./package.tgz",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit",
    "prepack": "cp package.json package.json.bak && node ../../scripts/prepare-npm-package.js",
    "postpack": "mv package.json.bak package.json"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/api-clients": "13.2.0-pre",
    "@grafana/data": "13.2.0-pre",
    "@grafana/i18n": "13.2.0-pre",
    "@grafana/runtime": "13.2.0-pre",
    "@grafana/ui": "13.2.0-pre",
    "@reduxjs/toolkit": "2.10.1",
    "lodash": "^4.17.23",
    "react-hook-form": "^7.49.2",
    "react-loading-skeleton": "3.5.0",
    "react-redux": "9.2.0",
    "react-router-dom-v5-compat": "^6.26.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.1.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^29.5.4",
    "@types/lodash": "4.17.20",
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.28.1",
    "jest": "^29.6.4",
    "rollup": "^4.60.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
