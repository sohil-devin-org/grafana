{
  "author": "Grafana Labs",
  "license": "Apache-2.0",
  "name": "@grafana/migrate-to-cloud",
  "version": "13.2.0-pre",
  "private": true,
  "description": "Grafana migrate-to-cloud feature module",
  "keywords": [
    "grafana",
    "cloud",
    "migration"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "http://github.com/grafana/grafana.git",
    "directory": "packages/grafana-migrate-to-cloud"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@grafana-app/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "./dist",
    "./README.md"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json && rollup -c rollup.config.ts --configPlugin esbuild",
    "bundle": "rollup -c rollup.config.ts --configPlugin esbuild",
    "clean": "rimraf ./dist ./compiled ./package.tgz",
    "typecheck": "tsc --emitDeclarationOnly false --noEmit"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/api-clients": "workspace:*",
    "@grafana/data": "workspace:*",
    "@grafana/i18n": "workspace:*",
    "@grafana/runtime": "workspace:*",
    "@grafana/ui": "workspace:*",
    "@reduxjs/toolkit": "2.10.1",
    "react": "18.3.1",
    "react-hook-form": "^7.49.2",
    "react-loading-skeleton": "3.5.0",
    "react-redux": "9.2.0"
  },
  "devDependencies": {
    "@grafana/test-utils": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/chance": "^1.1.7",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "chance": "^1.1.13",
    "esbuild": "0.28.1",
    "jest": "^29.6.4",
    "msw": "2.10.4",
    "react-dom": "18.3.1",
    "rollup": "^4.60.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "rxjs": "7.8.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
